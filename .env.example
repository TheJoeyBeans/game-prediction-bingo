# Copy to .env.local and fill in. Never commit real values.
# Nothing here except NEXT_PUBLIC_* is sent to the browser; keep secrets unprefixed.

# Google Tag Manager container id (public by design)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Supabase project URL: Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_…): Project Settings → API Keys. Server only, bypasses RLS
SUPABASE_SECRET_KEY=

# Random string mixed into IP hashes for rate limiting, e.g. from: openssl rand -hex 32
IP_HASH_SALT=

# Vercel sends this as a Bearer token on cron requests; set it in Vercel (optional locally)
CRON_SECRET=
